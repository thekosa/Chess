<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pl.projekt.szachy.desktop.MainWindowController"
      alignment="TOP_CENTER" spacing="28" styleClass="game-window">
    <StackPane fx:id="boardContainer" />
    <VBox alignment="TOP_LEFT" spacing="14" prefWidth="220">
        <Label text="Szachy" styleClass="title" />
        <Label fx:id="turnLabel" wrapText="true" styleClass="turn-label" />
        <Label text="Kliknij figurę, a potem podświetlone pole." wrapText="true" />
        <Label fx:id="messageLabel" wrapText="true" minHeight="48" styleClass="message-label" />
        <Button fx:id="newGameButton" text="Nowa gra" onAction="#newGame" maxWidth="Infinity" />
        <Button fx:id="retryButton" text="Ponów ruch komputera" onAction="#retryComputer" visible="false" managed="false" maxWidth="Infinity" />
        <Button fx:id="claimDrawButton" text="Zgłoś remis" onAction="#claimDraw" visible="false" managed="false" maxWidth="Infinity" />
        <Label fx:id="capturedLabel" wrapText="true" minHeight="64" styleClass="captured-label" />
        <Label text="Ruchy" styleClass="history-title" />
        <ListView fx:id="historyList" prefHeight="220" maxHeight="220" />
    </VBox>
</HBox>
